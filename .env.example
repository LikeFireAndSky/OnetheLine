# 환경변수 예시 파일입니다. 복사해서 .env.local 로 만든 뒤 실제 값을 채우세요.
# 모든 값은 서버 전용입니다. 시크릿에는 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.

# ----- NextAuth -----
# 서비스 기준 URL (로컬 개발 시 http://localhost:3000)
NEXTAUTH_URL=https://onetheline.xyz
# 세션 JWT 암호화 키 (예: openssl rand -base64 32 로 생성)
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ----- Amazon Cognito (Google 페더레이션) -----
# Cognito User Pool 앱 클라이언트 ID
COGNITO_CLIENT_ID=your-cognito-app-client-id
# Cognito User Pool 앱 클라이언트 시크릿
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
# Cognito 발급자 URL (User Pool ID 포함, 끝에 슬래시 없음)
COGNITO_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_XXXXXXXXX

# ----- Google RISC (계정 보안 이벤트 수신, pages/api/risc.ts) -----
# Cognito Google IdP에 등록한 Google OAuth 클라이언트 ID (토큰 audience 검증용)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ----- 네이버 책 검색 Open API (로그인 아님, 서버에서만 호출) -----
# 예전 NEXT_PUBLIC_NAVER_* 값은 브라우저에 노출되었으므로 재발급한 시크릿을 사용하세요.
NAVER_SEARCH_CLIENT_ID=your-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=your-naver-search-client-secret

# ----- AWS -----
# (선택) DynamoDB 테이블 리전. 미설정 시 ap-northeast-2
# DYNAMODB_REGION=ap-northeast-2
# (선택) 레거시 정적 액세스 키. 두 값이 모두 있을 때만 사용되며,
# 비워두면 SDK 기본 자격 증명 체인(IAM 역할)을 사용합니다. 운영 환경에서는 IAM 역할을 권장합니다.
NEXT_AWS_ACCESS_KEY_ID=
NEXT_AWS_SECRET_ACCESS_KEY=
